NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/employee_management
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=200
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUDIT_LOG_RETENTION_DAYS=365
INACTIVE_EMPLOYEE_REVIEW_DAYS=2555
DOCUMENT_STORAGE_DIR=
DOCUMENT_MAX_SIZE_MB=

# Optional: used only by npm run seed:dev-hr when NODE_ENV=development
DEV_HR_EMAIL=hr.dev@example.local
DEV_HR_PASSWORD=choose_a_private_password_at_least_8_characters
DEV_HR_FIRST_NAME=Dev
DEV_HR_LAST_NAME=HR

# Optional: local bootstrap admin only; never use as a production credential.
DEV_ADMIN_EMAIL=admin.dev@example.local
DEV_ADMIN_PASSWORD=choose_a_private_password_at_least_12_characters
DEV_ADMIN_FIRST_NAME=Dev
DEV_ADMIN_LAST_NAME=Admin
