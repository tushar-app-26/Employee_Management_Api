{
  "name": "employee-management-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "migration:show": "node --import tsx ./node_modules/typeorm/cli.js migration:show -d src/config/database.ts",
    "migration:generate": "node --import tsx ./node_modules/typeorm/cli.js migration:generate -d src/config/database.ts",
    "migration:run": "node --import tsx ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "node --import tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
    "seed:dev-hr": "tsx src/scripts/create-dev-hr-user.ts",
    "seed:dev-admin": "tsx src/scripts/create-dev-admin-user.ts",
    "seed:dev-departments": "tsx src/scripts/seed-development-departments.ts",
    "audit:prune": "tsx src/scripts/prune-audit-logs.ts",
    "retention:report": "tsx src/scripts/report-retention-candidates.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@types/multer": "^2.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
